DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_MODEL=deepseek-v4-flash

# Optional: make the Next.js UI call the Python FastAPI backend directly.
# Start it with `python -m cabinguard`, then uncomment this line.
# NEXT_PUBLIC_CABINGUARD_API_URL=http://127.0.0.1:8000

# Optional: comma-separated browser origins allowed by the Python API.
# CABINGUARD_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional: only needed for the separate OpenAI Realtime speech-to-speech page.
# OPENAI_API_KEY=your_openai_api_key

# Optional: enable model-based output moderation for the Realtime experiment.
# ENABLE_REALTIME_OUTPUT_GUARDRAIL=false

# Optional: enable this only when the local network reaches OpenAI through a proxy.
# HTTPS_PROXY=http://127.0.0.1:7890
