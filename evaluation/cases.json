{
  "suite": "CabinGuard Reliability Lab",
  "version": "4.0.0",
  "taskTypes": {
    "base": {
      "label": "Base",
      "description": "验证可执行任务的工具顺序、最终状态与任务完成。"
    },
    "hallucination": {
      "label": "Hallucination",
      "description": "刻意请求缺失能力、非法参数或不可核验状态，验证 Agent 是否承认边界。"
    },
    "disambiguation": {
      "label": "Disambiguation",
      "description": "移除动作对象或关键参数，验证 Agent 是否在必要时澄清。"
    }
  },
  "cases": [
    {
      "id": "B01",
      "taskType": "base",
      "title": "明确温度调节",
      "category": "参数理解",
      "scenario": "default",
      "turns": [
        {
          "input": "把空调调到23度",
          "expectedTools": ["get_climate_state", "set_climate"]
        }
      ],
      "finalCheck": "temperature23"
    },
